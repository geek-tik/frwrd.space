# Домен сервиса
BASE_DOMAIN=frwrd.space

# PostgreSQL
POSTGRES_USER=forward
POSTGRES_PASSWORD=forward
POSTGRES_DB=forward
DATABASE_URL=postgres://forward:forward@postgres:5432/forward?sslmode=disable

# Server
HTTP_ADDR=:8080
EDGE_ADDR=:8081
AGENT_ADDR=:8082
JWT_SECRET=change-me-in-production-use-long-random-string
SECURE_COOKIES=false

# Dashboard (хостовой порт контейнера web)
WEB_PORT=3080

# Backend для Vite при запуске dashboard вне Docker (`cd web && npm run dev`)
VITE_API_PROXY_TARGET=http://localhost:8080

# Публикация портов на хост: 127.0.0.1 (рекомендуется) или 0.0.0.0
FORWARD_BIND=127.0.0.1

# --- Локальная разработка (agent profile tunnel) ---
FORWARD_SERVER_URL=ws://server:8082/agent/connect
FORWARD_API_TOKEN=
FORWARD_LOCAL_HOST=host.docker.internal
FORWARD_DASHBOARD_URL=http://localhost:3080

# --- Продакшен на сервере (.env рядом с compose) ---
# JWT_SECRET=<случайная строка>
# POSTGRES_PASSWORD=<сильный пароль>
# SECURE_COOKIES=true
# FORWARD_BIND=127.0.0.1
# WEB_PORT=<свободный хостовой порт; тот же в nginx proxy_pass>

# --- Агент с машины разработчика к продакшену ---
# FORWARD_SERVER_URL=wss://connect.frwrd.space/agent/connect
# FORWARD_DASHBOARD_URL=https://frwrd.space
