# Временный nginx-конфиг БЕЗ SSL (пока нет сертификатов)
# /etc/nginx/sites-available/forward
#
# Порт dashboard = WEB_PORT из .env (ниже 3080 — как в .env.example).
# Pre-launch basic auth: см. host.conf.example и SERVER_SETUP.md §7.1

server {
    listen 80;
    server_name www.frwrd.space;
    return 301 http://frwrd.space$request_uri;
}

server {
    listen 80;
    server_name frwrd.space;

    # auth_basic           "Forward private";
    # auth_basic_user_file /etc/nginx/htpasswd/forward;

    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name api.frwrd.space;

    # auth_basic           "Forward private";
    # auth_basic_user_file /etc/nginx/htpasswd/forward;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name connect.frwrd.space;

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}

server {
    listen 80;
    server_name ~^(?<subdomain>(?!www|api|connect)[a-z0-9-]+)\.frwrd\.space$;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
